# Copy to .env.local and fill in. Never commit .env.local.

# Anthropic Console — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Self-hosted n8n (n8n.srv1075406.hstgr.cloud) — Settings > n8n API
N8N_API_KEY=
# Base URL for the n8n public REST API, e.g. https://<host>/api/v1
# Used by the curl flow in n8n-workflows/README.md
N8N_API_BASE=

# Used by scripts/ alongside the `youtube-transcript` dependency.
# Source unconfirmed — verify before filling in.
YT_TRANSCRIPT_TOKEN=
